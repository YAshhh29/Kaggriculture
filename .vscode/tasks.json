{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run all tests",
			"type": "process",
			"command": "${workspaceFolder}\\.conda\\python.exe",
			"args": ["-m", "unittest", "-v"],
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "Validate all package builders",
			"type": "process",
			"command": "${workspaceFolder}\\.conda\\python.exe",
			"args": ["-m", "unittest", "discover", "-s", "tests", "-p", "test_prepare_*.py", "-v"],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Prepare learned service submission",
			"type": "process",
			"command": "${workspaceFolder}\\.conda\\python.exe",
			"args": ["-m", "tools.packaging.prepare_learned_service_submission"],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Validate learned service Kaggle loader",
			"type": "process",
			"command": "${workspaceFolder}\\.conda\\python.exe",
			"args": ["-m", "tools.validation.validate_submission", "submissions\\learned-service\\main.py", "--seed", "184"],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Validate learned service equivalence",
			"type": "process",
			"command": "${workspaceFolder}\\.conda\\python.exe",
			"args": ["-m", "tools.validation.validate_learned_service_equivalence", "submissions\\learned-service\\main.py", "--seed", "184"],
			"isBackground": false,
			"problemMatcher": []
		},
