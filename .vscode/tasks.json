			"command": "${workspaceFolder}\\.conda\\python.exe",
			"args": ["-m", "tools.validation.validate_submission", "submissions\\demand-animal\\main.py", "--seed", "186"],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Validate demand animal equivalence",
			"type": "process",
			"command": "${workspaceFolder}\\.conda\\python.exe",
			"args": ["-m", "tools.validation.validate_demand_animal_equivalence", "submissions\\demand-animal\\main.py", "--seed", "186"],
			"isBackground": false,
			"problemMatcher": []
