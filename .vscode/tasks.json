			"args": ["-m", "research.analysis.run_overnight_shadow", "--seed-start", "188", "--seed-count", "1", "--opponent", "agents\\experimental_lifecycle_agent.py", "--output", "artifacts\\benchmarks\\shadow-smoke.json"],
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		},
		{
			"label": "Run overnight shadow suite",
			"type": "process",
			"command": "${workspaceFolder}\\.conda\\python.exe",
			"args": ["-m", "research.analysis.run_overnight_shadow", "--seed-start", "188", "--seed-count", "10", "--output", "artifacts\\benchmarks\\overnight-shadow.json"],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Run future labor gate",
			"type": "process",
			"command": "${workspaceFolder}\\.conda\\python.exe",
			"args": ["-m", "research.evaluation.evaluate_future_labor", "--seed-start", "213", "--seed-count", "1", "--output", "artifacts\\benchmarks\\v1327-opponent-aware-future-labor-broad-gate-seed213.json"],
