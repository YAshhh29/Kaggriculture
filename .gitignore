# Python environments and caches
.venv/
.venv-*/
.conda/
__pycache__/
*.py[cod]
.pytest_cache/

# Generated experiment output: benchmarks, rendered replays, datasets, audits.
# Everything here is reproducible from the scripts in tools/ and research/.
artifacts/

# Local arena: stored games, rendered replays, screenshots and logs.
arena/

# Replay-derived datasets and ladder game tapes. They can contain Kaggle
# Competition Data, so only the guide and the one plan an agent reads at
# runtime are committed (see rl/data/README.md).
rl/data/*
!rl/data/README.md
!rl/data/macro_plan.json
rl/checkpoints/
rl/runs/

# Kaggle downloads: notebooks, corpora, live opponent tapes, rules pages.
kaggle_cache/

# Extracted public notebook agents: other people's code, kept for local
# evaluation only and re-extractable from the public notebooks
# (tools/data/extract_notebook_agents.py).
rl/public/nb_*.py
rl/public_bak*/

# Packages kept locally without adding every generated bundle.
submissions/legacy/

# Local package builds (tools/packaging/build_final.py).
build/
