.venv/
.venv-*/
.conda/
__pycache__/
*.py[cod]

# Generated experiment outputs stay local. Curated models and small fixtures
# belong in models/ and tests/fixtures/ instead.
artifacts/analysis/
artifacts/benchmarks/
artifacts/datasets/
artifacts/diagnostics/
artifacts/direct/
artifacts/live-replays/
artifacts/models/
artifacts/top-replays/
artifacts/ui/
artifacts/*.json
artifacts/*.html

# Local RL datasets, model checkpoints, and run outputs can contain Kaggle
# Competition Data or large generated artifacts.
rl/data/
rl/checkpoints/
rl/runs/

# Standalone upload outputs are reproducible from packaging scripts. Keep the
# legacy packages locally without adding every generated bundle.
submissions/legacy/

# Rendered match replays are ~47MB of embedded replay JSON each.
artifacts/replays/

# Live opponent tapes fetched from the ladder (large, refetchable).
kaggle_cache/live_clones/

# Arena output. A rendered replay is ~45 MB; stored games re-render
# deterministically from their seed and action tapes.
arena/replays/
arena/games/
arena/shots/
arena/index.html

# Extracted public notebook agents: other people's code, kept for local
# evaluation only and re-extractable from kaggle_cache/notebooks.
rl/public/nb_*.py
# Dated local backups of that folder (byte-identical copies of the above).
rl/public_bak*/
