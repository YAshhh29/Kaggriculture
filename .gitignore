.venv/
.venv-*/
.conda/
__pycache__/
*.py[cod]

# Generated experiment outputs stay local. Curated models and small fixtures
# belong in models/ and tests/fixtures/ instead.
artifacts/analysis/
artifacts/benchmarks/
artifacts/datasets/
artifacts/diagnostics/
artifacts/direct/
artifacts/live-replays/
artifacts/models/
artifacts/top-replays/
artifacts/ui/
artifacts/*.json
artifacts/*.html

# Local RL datasets, model checkpoints, and run outputs can contain Kaggle
# Competition Data or large generated artifacts.
rl/data/
rl/checkpoints/
rl/runs/

# Standalone upload outputs are reproducible from packaging scripts. Keep the
# legacy packages locally without adding every generated bundle.
submissions/legacy/

# Rendered match replays are ~47MB of embedded replay JSON each.
artifacts/replays/
